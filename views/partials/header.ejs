<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Notes App' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Caveat:wght@500;700&family=Merriweather:wght@400;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="logo">NoteFlow</a>

    <div class="nav-links">

      <% if (currentUser) { %>

    <p class="welcome-text">
        Welcome back, <strong><%= currentUser.username %></strong> 👋
    </p>

    <div class="hero-actions">
        <a href="/notes" class="btn btn-primary">
            Go to My Notes
        </a>
        <a href="/logout">Logout</a>
    </div>

<% } else { %>

    <div class="hero-actions">
        <a href="/signup" class="btn btn-primary">
            Get Started Free
        </a>

        <a href="/login" class="btn btn-secondary">
            Login
        </a>
    </div>

<% } %>
              
   
    </div>
  </nav>
